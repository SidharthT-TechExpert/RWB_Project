NODE_ENV=production

# ── Service URLs (use container names as hostnames) ────────────
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
RESTAURANT_SERVICE_URL=http://restaurant-service:3003
FOOD_SERVICE_URL=http://food-service:3004
BOOKING_SERVICE_URL=http://booking-service:3005
ORDER_SERVICE_URL=http://order-service:3006
PAYMENT_SERVICE_URL=http://payment-service:3007
REVIEW_SERVICE_URL=http://review-service:3008
SEARCH_SERVICE_URL=http://search-service:3009
LOCATION_SERVICE_URL=http://location-service:3010
NOTIFICATION_SERVICE_URL=http://notification-service:3011
ADMIN_SERVICE_URL=http://admin-service:3012
ANALYTICS_SERVICE_URL=http://analytics-service:3013

# ── MongoDB (container hostname) ──────────────────────────────
MONGODB_URI=mongodb://mongodb:27017/quickbite
MONGODB_URI_AUTH=mongodb://mongodb:27017/quickbite_auth
MONGODB_URI_USER=mongodb://mongodb:27017/quickbite_user
MONGODB_URI_RESTAURANT=mongodb://mongodb:27017/quickbite_restaurant
MONGODB_URI_FOOD=mongodb://mongodb:27017/quickbite_food
MONGODB_URI_BOOKING=mongodb://mongodb:27017/quickbite_booking
MONGODB_URI_ORDER=mongodb://mongodb:27017/quickbite_order
MONGODB_URI_PAYMENT=mongodb://mongodb:27017/quickbite_payment
MONGODB_URI_REVIEW=mongodb://mongodb:27017/quickbite_review
MONGODB_URI_SEARCH=mongodb://mongodb:27017/quickbite_search
MONGODB_URI_NOTIFICATION=mongodb://mongodb:27017/quickbite_notification
MONGODB_URI_ADMIN=mongodb://mongodb:27017/quickbite_admin
MONGODB_URI_ANALYTICS=mongodb://mongodb:27017/quickbite_analytics

# ── Redis (container hostname) ────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# ── RabbitMQ (container hostname) ────────────────────────────
RABBITMQ_URL=amqp://quickbite:quickbite_secret@rabbitmq:5672

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=quickbite-docker-access-secret-change-in-prod
JWT_REFRESH_SECRET=quickbite-docker-refresh-secret-change-in-prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3006,http://localhost:3000

# ── Optional ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@quickbite.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
GOOGLE_MAPS_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
