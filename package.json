{
  "name": "quickbite",
  "version": "1.0.0",
  "private": true,
  "description": "QuickBite — restaurant pre-booking platform (monolith)",
  "scripts": {
    "dev:api":      "infisical run --env=dev -- npm run dev --prefix server",
    "dev:web":      "npm run dev --prefix apps/web",
    "build:api":    "npm run build --prefix server",
    "build:web":    "npm run build --prefix apps/web",
    "start:api":    "infisical run --env=prod -- npm run start --prefix server",
    "infra:up":     "docker compose up mongodb redis -d",
    "infra:down":   "docker compose down",
    "docker:up":    "docker compose up -d",
    "docker:down":  "docker compose down",
    "docker:build": "docker compose build",
    "format":       "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": ["eslint --fix", "prettier --write"],
    "*.{json,md,yaml,yml}": ["prettier --write"]
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
