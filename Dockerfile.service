# Shared Dockerfile template for all Node.js microservices
# Usage: docker build --build-arg SERVICE=auth-service -t quickbite-auth .

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install dependencies
FROM base AS deps
COPY package.json ./
COPY packages/shared/package.json ./packages/shared/
ARG SERVICE
COPY services/${SERVICE}/package.json ./services/${SERVICE}/
RUN npm install --workspaces --if-present

# Build
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY packages/shared ./packages/shared
ARG SERVICE
COPY services/${SERVICE} ./services/${SERVICE}
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/services/${SERVICE}/node_modules ./services/${SERVICE}/node_modules
WORKDIR /app/services/${SERVICE}
RUN npm run build

# Production
FROM base AS runner
ENV NODE_ENV production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nodeuser
COPY --from=builder --chown=nodeuser:nodejs /app/services/${SERVICE}/dist ./dist
COPY --from=builder --chown=nodeuser:nodejs /app/node_modules ./node_modules
USER nodeuser
EXPOSE 3000
CMD ["node", "dist/server.js"]
