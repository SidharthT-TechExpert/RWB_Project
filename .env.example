# ============================================
# QuickBite Environment Variables
# ============================================

# Node Environment
NODE_ENV=development

# API Gateway
API_GATEWAY_PORT=3000
API_GATEWAY_URL=http://localhost:3000

# Service URLs
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
RESTAURANT_SERVICE_URL=http://localhost:3003
FOOD_SERVICE_URL=http://localhost:3004
BOOKING_SERVICE_URL=http://localhost:3005
ORDER_SERVICE_URL=http://localhost:3006
PAYMENT_SERVICE_URL=http://localhost:3007
REVIEW_SERVICE_URL=http://localhost:3008
SEARCH_SERVICE_URL=http://localhost:3009
LOCATION_SERVICE_URL=http://localhost:3010
NOTIFICATION_SERVICE_URL=http://localhost:3011
ADMIN_SERVICE_URL=http://localhost:3012
ANALYTICS_SERVICE_URL=http://localhost:3013

# MongoDB (credentials match docker-compose.yml)
MONGODB_URI=mongodb://quickbite:quickbite_secret@localhost:27017/quickbite?authSource=admin
MONGODB_URI_AUTH=mongodb://quickbite:quickbite_secret@localhost:27017/quickbite_auth?authSource=admin
MONGODB_URI_USER=mongodb://quickbite:quickbite_secret@localhost:27017/quickbite_user?authSource=admin
MONGODB_URI_RESTAURANT=mongodb://quickbite:quickbite_secret@localhost:27017/quickbite_restaurant?authSource=admin
MONGODB_URI_FOOD=mongodb://quickbite:quickbite_secret@localhost:27017/quickbite_food?authSource=admin
MONGODB_URI_BOOKING=mongodb://quickbite:quickbite_secret@localhost:27017/quickbite_booking?authSource=admin
MONGODB_URI_ORDER=mongodb://quickbite:quickbite_secret@localhost:27017/quickbite_order?authSource=admin
MONGODB_URI_PAYMENT=mongodb://quickbite:quickbite_secret@localhost:27017/quickbite_payment?authSource=admin
MONGODB_URI_REVIEW=mongodb://quickbite:quickbite_secret@localhost:27017/quickbite_review?authSource=admin
MONGODB_URI_SEARCH=mongodb://quickbite:quickbite_secret@localhost:27017/quickbite_search?authSource=admin
MONGODB_URI_NOTIFICATION=mongodb://quickbite:quickbite_secret@localhost:27017/quickbite_notification?authSource=admin
MONGODB_URI_ADMIN=mongodb://quickbite:quickbite_secret@localhost:27017/quickbite_admin?authSource=admin
MONGODB_URI_ANALYTICS=mongodb://quickbite:quickbite_secret@localhost:27017/quickbite_analytics?authSource=admin

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Apple OAuth
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@quickbite.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=quickbite-uploads

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Stripe
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# RabbitMQ (credentials match docker-compose.yml)
RABBITMQ_URL=amqp://quickbite:quickbite_secret@localhost:5672
RABBITMQ_USER=quickbite
RABBITMQ_PASS=quickbite_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your-google-maps-api-key
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
