# ─────────────────────────────────────────────────────────────
# QuickBite Server — Environment Variables
# Copy this file:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ═══════════════════════════════════════════════════════════════
# INFISICAL (Secret Manager) — recommended for all environments
# ═══════════════════════════════════════════════════════════════
# If these 3 vars are set, ALL other secrets below are loaded
# automatically from Infisical at startup.
# Leave blank to use the local .env values instead.
#
# How to get these:
#   1. Create a project at https://app.infisical.com
#   2. Go to Project Settings → Machine Identities → Create
#   3. Copy the Client ID and Client Secret
#   4. Copy the Project ID from Project Settings → General

INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=

# Environment slug in Infisical (dev | staging | prod)
# Defaults: development=dev, staging=staging, production=prod
INFISICAL_ENV=dev

# Optional: self-hosted Infisical instance
# INFISICAL_SITE_URL=https://infisical.yourdomain.com

# ═══════════════════════════════════════════════════════════════
# LOCAL FALLBACK — used when Infisical is NOT configured
# (or in development to override individual secrets)
# ═══════════════════════════════════════════════════════════════

# ── MongoDB ───────────────────────────────────────────────────
# Local Docker:
MONGODB_URI=mongodb://127.0.0.1:27017/quickbite
# Atlas production example:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/quickbite?retryWrites=true&w=majority

# ── Redis ─────────────────────────────────────────────────────
# Local Docker:
REDIS_URL=redis://localhost:6379
# Upstash production example:
# REDIS_URL=rediss://default:password@host.upstash.io:6380

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=change-this-to-another-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS / Frontend ───────────────────────────────────────────
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# ── Email / SMTP ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=noreply@quickbite.com

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ── Google Maps ───────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Firebase (push notifications) ────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# ── Razorpay ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── SMS Provider ───────────────────────────────────────────────
# Set SMS_PROVIDER to 'msg91' or '2factor'
# MSG91 is STRONGLY recommended for India — text-only, no voice call fallback.
SMS_PROVIDER=msg91

# MSG91 (https://msg91.com) — recommended for Indian SMS (Text only, no voice)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=QKBITE

# 2Factor (https://2factor.in) — fallback, contact support@2factor.in to disable voice OTP
TWOFACTOR_API_KEY=
TWOFACTOR_OTP_TEMPLATE=
TWOFACTOR_SENDER_ID=QKBITE

# Daily OTP rate limit cap
MAX_DAILY_OTP=40
