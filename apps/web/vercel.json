{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "env": {
    "NEXT_PUBLIC_API_URL": "@quickbite_api_url",
    "NEXT_PUBLIC_RAZORPAY_KEY_ID": "@quickbite_razorpay_key",
    "NEXT_PUBLIC_GOOGLE_MAPS_KEY": "@quickbite_maps_key"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.quickbite.app/api/:path*" }
  ]
}
