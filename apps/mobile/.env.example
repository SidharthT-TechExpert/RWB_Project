# ─── Copy this file to .env and fill in your values ─────────
# cp .env.example .env

# API URL — use your local machine IP (not localhost) so device/emulator can reach it
# Find your IP: ipconfig (Windows) or ifconfig (Mac/Linux)
EXPO_PUBLIC_API_URL=http://192.168.1.x:3000/api/v1

# For production
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
